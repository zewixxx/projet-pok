{
  "name": "projet-pok",
  "private": true,
  "version": "0.1.0",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "icon": "node scripts/make-icon.cjs",
    "electron:dev": "npm run electron:compile && concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:preview": "npm run build && npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder"
  },
  "build": {
    "appId": "com.poker.projet-pok",
    "productName": "Projet-pok",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/@node-llama-cpp/win-x64-cuda*/**",
      "!node_modules/@node-llama-cpp/win-x64-vulkan/**",
      "!node_modules/@node-llama-cpp/win-arm64/**"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Projet-pok"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "adm-zip": "^0.5.16",
    "lucide-react": "^1.61.0",
    "node-llama-cpp": "^3.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.0"
  }
}
